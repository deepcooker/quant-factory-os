ard_alignment\": \"aligned\",\n      \"evidence\": [\n        \"docs/PROJECT_GUIDE.md#Q9: 标准答案明确讨论优先流程。\",\n        \"docs/WORKFLOW.md#4. S1 讨论层: 已定义 `orient/choose/council/arbiter` 的职责与下一跳。\",\n        \"AGENTS.md#6) Workflow skeleton: 推荐讨论优先 lane 后再 `do`。\"\n      ],\n      \"drift_note\": \"none\",\n      \"return_to_mainline\": \"守住讨论先于执行，避免先写代码后补理由。\"\n    },\n    {\n      \"question_id\": \"Q10\",\n      \"question\": \"基建项目的代码实施流程是什么样的，它需要哪些 agent 进行协作呢，怎么保证这些角色都是独立思考的，他们每一个角色的定义是什么样子的，怎么保证其独立思考的，我们现在都实现了吗，怎么实现的？\",\n      \"answer\": \"实施流程是在讨论合同收敛后走 `do -> verify -> review -> ship`，理想角色包括产品、架构、研发、测试，分别负责目标边界、架构约束、实现路径和验证回归。独立思考靠 `council` 分角色产出、`arbiter` 再收敛；当前仓库只有这条流程骨架，离真正高并发独立 agent 团队还没到位。\",\n      \"standard_alignment\": \"aligned\",\n      \"evidence\": [\n        \"docs/PROJECT_GUIDE.md#Q10: 标准答案给出角色分工与独立思考机制。\",\n        \"docs/WORKFLOW.md#4.3 `council`: 职责是多角色独立给出意见。\",\n        \"docs/WORKFLOW.md#4. S1 讨论层: 当前已实现的是讨论链骨架而非完整 agent 团队。\"\n      ],\n      \"drift_note\": \"none\",\n      \"return_to_mainline\": \"把“理想协作形态”和“当前实现程度”分开，避免夸大现状。\"\n    },\n    {\n      \"question_id\": \"Q11\",\n      \"question\": \"项目基建里的 task，pr，run，project 的都是什么意思，还有其他的概念吗，他们的生命周期管理是怎么样的？\",\n      \"answer\": \"`project` 管长期上下文，`run` 是一轮方向到交付的证据容器，`task` 是 run 内最小可执行切片，`PR` 是交付与审查单元；另外还有 `queue`、`gate`、`evidence`、`discussion artifacts`。生命周期大体是 `project -> run -> discussion artifacts -> task -> verify/review -> ship/PR -> state update`。\",\n      \"standard_alignment\": \"aligned\",\n      \"evidence\": [\n        \"docs/PROJECT_GUIDE.md#Q11: 标准答案统一了这些名词及生命周期。\",\n        \"docs/ENTITIES.md#2. Project: `project_id` 承载长期命名空间。\",\n        \"docs/ENTITIES.md#3. Run: `run_id` 是一轮方向讨论到交付的周期容器。\",\n        \"docs/ENTITIES.md#4. Task: `task_id` 是 run 内最小可执行切片。\"\n      ],\n      \"drift_note\": \"none\",\n      \"return_to_mainline\": \"统一对象层级，防止把 task、run、session 混为一谈。\"\n    },\n    {\n      \"question_id\": \"Q12\",\n      \"question\": \"我们在项目的准备工作做好后，我们一个需求讨论方向，从流程的哪一步开始？\",\n      \"answer\": \"准备工作完成后应从 `orient` 开始讨论方向，然后按 `choose -> council -> arbiter -> slice` 收敛成执行合同和最小 task，而不是直接 `do`。`ready` 只是给出 Go/No-Go 门禁，不授权直接写代码。\",\n      \"standard_alignment\": \"aligned\",\n      \"evidence\": [\n        \"docs/PROJECT_GUIDE.md#Q12: 标准答案明确讨论从 `orient` 开始。\",\n        \"docs/WORKFLOW.md#3.3 `ready`: 下一跳是 `orient`。\",\n        \"docs/WORKFLOW.md#4.1 `orient`: 职责是生成候选方向。\"\n      ],\n      \"drift_note\": \"none\",\n      \"return_to_mainline\": \"接上岗层后的正确下一步，防止误把 ready 当执行许可。\"\n    },\n    {\n      \"question_id\": \"Q13\",\n      \"question\": \"我们分支代码的管理是怎么样的，现在满足需求吗？\",\n      \"answer\": \"当前纪律是一个 task 对应一个分支和一个 PR，PR 标题要带 `RUN_ID`，正文要写 Why/What/Verify/Evidence paths；在现阶段这已经够用。重点是保证 run continuity 和可审计交付，尤其 ship 不能为了出 PR 强制切回错误基线。\",\n      \"standard_alignment\": \"aligned\",\n      \"evidence\": [\n        \"docs/PROJECT_GUIDE.md#Q13: 标准答案明确一任务一分支一 PR 与 active branch continuity。\",\n        \"AGENTS.md#13) PR discipline: PR title/body 的硬要求已经写明。\",\n        \"TASKS/QUEUE.md#ship 相关任务块: 最近多轮任务都在修 ship continuity 与 merge recovery。\"\n      ],\n      \"drift_note\": \"none\",\n      \"return_to_mainline\": \"把本地改动重新约束到分支与 PR 纪律，而不是只关心能不能跑。\"\n    },\n    {\n      \"question_id\": \"Q14\",\n      \"question\": \"每次做完任务，你必须要做什么事情？\",\n      \"answer\": \"每次任务完成后，必须验证、更新 run evidence、同步 owner docs 变化、跑 smoke/release-ready 检查，然后再 ship。最低要求是更新 `reports/<RUN_ID>/summary.md`、`decision.md`、`meta.json`，否则不算完成。\",\n      \"standard_alignment\": \"aligned\",\n      \"evidence\": [\n        \"docs/PROJECT_GUIDE.md#Q14: 标准答案定义了完成后的闭环动作。\",\n        \"AGENTS.md#7) Evidence is memory (hard gate): 每个 run 必须更新 `meta.json`、`summary.md`、`decision.md`。\",\n        \"AGENTS.md#12) Documentation freshness gate: 规则变化时必须同步 owner docs。\"\n      ],\n      \"drift_note\": \"none\",\n      \"return_to_mainline\": \"把“写完代码”纠正为“验证、证据、文档、ship-ready 都完成”。\"\n    },\n    {\n      \"question_id\": \"Q15\",\n      \"question\": \"这个项目是基建项目吗，如果我要的体验是为了用起来很爽，完全自动化，有