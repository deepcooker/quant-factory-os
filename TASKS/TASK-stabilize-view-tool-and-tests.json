  "task_summary": {
    "status": "completed",
    "key_updates": [
      "tools/view.sh was rewritten as a stable Python-based file reader while keeping the same tool path",
      "the reader now supports both direct execution and python3 invocation, plus legacy --lines START:END compatibility"
    ],
    "decisions": [
      "keep tools/view.sh as the formal file-reading surface instead of introducing a second view.py entrypoint",
      "use standard-library unittest so view tool verification does not depend on pytest being installed"
    ],
    "risks": [
      "AGENTS and prompts still rely on tools/view.sh semantics, so behavior changes must remain narrow and audited"
    ],
    "verification": [
      "python3 -m py_compile tools/view.sh",
      "tools/view.sh AGENTS.md --from 1 --to 3",
      "python3 tools/view.sh AGENTS.md --from 1 --to 3",
      "python3 tools/view.sh AGENTS.md --lines 1:3",
      "tools/view.sh AGENTS.md --find '^## 0' --context 1",
      "python3 -m unittest -q tests.test_view_tool"
    ],
    "next_steps": [
      "keep future file-reading changes minimal and validate against the unittest suite before changing reading policy again"
    ],
