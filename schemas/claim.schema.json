{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Claim",
  "type": "object",
  "required": [
    "claim_id",
    "claim",
    "type",
    "confidence",
    "evidence_level",
    "verification_required",
    "status",
    "doc_support",
    "code_support",
    "runtime_support",
    "contradictions"
  ],
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "claim": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_level": {
      "type": "string",
      "enum": [
        "documented",
        "code_verified",
        "runtime_verified",
        "inferred",
        "unknown"
      ]
    },
    "verification_required": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "rejected"
      ]
    },
    "doc_support": {
      "type": "array",
      "items": { "type": "string" }
    },
    "code_support": {
      "type": "array",
      "items": { "type": "string" }
    },
    "runtime_support": {
      "type": "array",
      "items": { "type": "string" }
    },
    "contradictions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}