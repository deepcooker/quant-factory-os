{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClarifiedJob",
  "type": "object",
  "required": [
    "job_id",
    "raw_request",
    "clarified_problem",
    "suspected_true_goal",
    "success_criteria",
    "assumptions",
    "missing_evidence",
    "claims",
    "recommended_next_step",
    "ready_for_run_planning"
  ],
  "properties": {
    "job_id": {
      "type": "string"
    },
    "raw_request": {
      "type": "string"
    },
    "clarified_problem": {
      "type": "string"
    },
    "suspected_true_goal": {
      "type": "string"
    },
    "success_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "missing_evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/definitions/claimRef" }
    },
    "recommended_next_step": {
      "type": "string"
    },
    "ready_for_run_planning": {
      "type": "boolean"
    }
  },
  "definitions": {
    "claimRef": {
      "type": "object",
      "required": ["claim_id", "claim"],
      "properties": {
        "claim_id": { "type": "string" },
        "claim": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}