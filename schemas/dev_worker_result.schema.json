{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevWorkerResult",
  "type": "object",
  "required": [
    "task_id",
    "role",
    "status",
    "summary",
    "artifacts",
    "risks",
    "next_actions",
    "requested_child_threads"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": ["dev"]
    },
    "status": {
      "type": "string",
      "enum": ["done", "blocked", "partial"]
    },
    "summary": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requested_child_threads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "goal", "reason"],
        "properties": {
          "role": { "type": "string" },
          "goal": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}